rules_version = '2';

// 로그인(Firebase Auth)된 "재직 중" 직원만 접근 가능. 이전엔 `allow read, write: if true`
// (완전 개방, 로그인 없이 누구나 전체 DB 읽기/쓰기 가능)였다가 `if request.auth != null`로
// 한 번 좁혔는데, 그때도 남아있던 두 구멍을 이번에 마저 막는다:
//   1) 로그인만 됐으면 자기 leave_portal_users 문서의 isManager를 스스로 true로 바꿔
//      관리자 권한을 가로챌 수 있었음 — isManager 필드는 클라이언트에서 아예 못 바꾸게 잠금
//      (승격은 Firebase 콘솔/서버 스크립트로만).
//   2) 퇴사 처리(resignationDate)된 계정도 Firebase Auth 세션 자체가 살아있으면 여전히
//      read/write 가능했음 — 본인 문서에 resignationDate가 있으면 통째로 차단.
//
// 회원가입/로그인은 서버(API Route, firebase-admin)에서만 처리되어 이 규칙의 영향을 받지
// 않는다(admin SDK는 규칙을 우회함) — 그래서 비로그인 상태에 구멍을 뚫어줄 필요가 없다.
//
// 남은 과제(이번 배포 대상 아님): requests/grants 컬렉션은 "재직 중이면 전부 read/write
// 가능"까지만 막아뒀고, "본인 것만" 또는 "관리자만 승인/부여" 같은 세부 권한은 아직 클라이언트
// UI(isManager 분기)에만 의존한다 — Firestore 직접 호출로 우회하면 뚫림. 필요해지면 각 컬렉션
// 문서에 승인/부여 권한자를 명시하고 규칙에서 검증하는 작업을 별도로 한다.
service cloud.firestore {
  match /databases/{database}/documents {

    function myUserDoc() {
      return get(/databases/$(database)/documents/leave_portal_users/$(request.auth.uid)).data;
    }

    function isActive() {
      return request.auth != null
        && exists(/databases/$(database)/documents/leave_portal_users/$(request.auth.uid))
        && !("resignationDate" in myUserDoc());
    }

    function isAdmin() {
      return isActive() && myUserDoc().isManager == true;
    }

    match /leave_portal_users/{userId} {
      allow read: if isActive();
      allow write: if isActive()
        && (request.auth.uid == userId || isAdmin())
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["isManager"]);
    }

    // 취소/상태변경 감사 로그 — 클라이언트는 기록만 남기고 읽지 않는다(관리자 화면도 이 컬렉션을
    // 직접 조회하지 않음). 수정·삭제로 로그를 조작할 수 없게 create만 허용.
    match /leave_portal_cancellations/{id} {
      allow create: if isActive();
    }
    match /leave_portal_status_overrides/{id} {
      allow create: if isActive();
    }

    // 로그인 시도 로그(leave_portal_login_logs)는 로그인 API(admin SDK)만 쓰고 클라이언트는
    // 아예 손대지 않으므로 규칙에 명시하지 않음 — 기본값(거부)이 그대로 적용된다.

    match /leave_portal_requests/{id} {
      allow read, write: if isActive();
    }
    match /leave_portal_grants/{id} {
      allow read, write: if isActive();
    }
    match /leave_portal_notifications/{id} {
      allow read, write: if isActive();
    }
    match /leave_portal_notification_logs/{id} {
      allow read, write: if isActive();
    }
    match /leave_portal_holidays/{id} {
      allow read, write: if isActive();
    }
  }
}
